# LeapFrog configuration — copy to `.env` and fill in as needed.
# Nothing here is required for demo mode: `npm run seed && npm run dev` runs the
# full UI on committed seed data with zero keys. These vars only affect LIVE mode.

# --- Live ingestion toggle ---------------------------------------------------
# Set to 1 to run the real pipeline (fetch -> enrich -> embed). Defaults to demo.
INGEST_LIVE=0

# --- Deployment: shared-link Basic auth (see docs/DEPLOY.md) -----------------
# Set BOTH to password-protect a hosted URL (e.g. a demo link for a reviewer).
# Leave either empty — the default — and the gate is OFF, so local `npm run dev`
# and demo mode stay zero-config.
DEMO_USER=
DEMO_PASS=

# --- Deployment: in-container pipeline scheduler -----------------------------
# When RUN_SCHEDULER=1 the web container also runs the pipeline on a loop (used on
# Render, where one disk = one service). docker-compose leaves this 0 and runs a
# separate worker container instead. Interval is in seconds (default 6h).
RUN_SCHEDULER=0
SCHEDULE_INTERVAL_SECONDS=21600

# --- Generation: OpenRouter (OpenAI-compatible gateway) ----------------------
# One key for all chat/enrichment. Get one at https://openrouter.ai/keys.
# Required only when INGEST_LIVE=1.
OPENROUTER_API_KEY=

# Endpoint + models are config, not code — swap providers without touching source.
# Any OpenRouter model slug works (e.g. anthropic/claude-3.5-sonnet, meta-llama/...).
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_ENRICH_MODEL=openai/gpt-4o-mini
OPENROUTER_CHAT_MODEL=openai/gpt-4o
# Change-detection (diff@1) and matrix drafted-edit (matrix-edit@1) models.
# Both default to the enrich model; both features run key-free on their
# deterministic paths when no key is set.
OPENROUTER_DIFF_MODEL=
OPENROUTER_MATRIX_EDIT_MODEL=

# --- Change detection --------------------------------------------------------
# Embedding similarity (0-1) at which a new item counts as a re-phrasing of an
# older one instead of a new development. Higher = stricter (fewer collapses).
DIFF_SIMILARITY_THRESHOLD=0.92

# --- Embeddings: local, no key ----------------------------------------------
# Runs on-device via transformers.js (OpenRouter has no embeddings endpoint).
# Changing the model changes the vector dimension — keep EMBEDDING_DIM
# (packages/core/src/db/constants.ts) and the vec_chunks migration in sync.
EMBEDDING_MODEL=Xenova/bge-small-en-v1.5

# --- Optional: raise source rate limits (fetch works without these) ---------
GITHUB_TOKEN=
NVD_API_KEY=

# --- Optional: alerts + storage ---------------------------------------------
# Slack incoming-webhook URL for impact >= 4 alerts; unset = in-app inbox only.
SLACK_WEBHOOK_URL=
# Override the single SQLite store location (defaults to data/leapfrog.sqlite).
LEAPFROG_DB_PATH=

# --- Email notifications (subscriptions) ------------------------------------
# `npm run notify` emails each subscription its new matching signals. Like the rest
# of the product this needs zero keys: without RESEND_API_KEY every digest is written
# as a real .eml file under data/outbox (open it in your mail client). Set the key to
# deliver to a real inbox instead — the "one env var flips demo -> live" pattern.
#
# Resend free-tier note: without a verified domain you can only send to your Resend
# account's own address, from onboarding@resend.dev. That is exactly the phone-demo case.
RESEND_API_KEY=
# From address for notifications (default: LeapFrog <onboarding@resend.dev>).
NOTIFY_EMAIL_FROM=
# Where demo-mode .eml files are written (default: data/outbox).
NOTIFY_OUTBOX_DIR=
# Origin used to build email deep links back into the app. For a phone demo set this to
# your laptop's LAN IP (e.g. http://192.168.1.23:3000) and run `next dev -H 0.0.0.0`.
APP_BASE_URL=http://localhost:3000
