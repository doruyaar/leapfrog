# LeapFrog configuration — copy to `.env` and fill in as needed.
# Nothing here is required for demo mode: `npm run seed && npm run dev` runs the
# full UI on committed seed data with zero keys. These vars only affect LIVE mode.

# --- Live ingestion toggle ---------------------------------------------------
# Set to 1 to run the real pipeline (fetch -> enrich -> embed). Defaults to demo.
INGEST_LIVE=0

# --- Generation: OpenRouter (OpenAI-compatible gateway) ----------------------
# One key for all chat/enrichment. Get one at https://openrouter.ai/keys.
# Required only when INGEST_LIVE=1.
OPENROUTER_API_KEY=

# Endpoint + models are config, not code — swap providers without touching source.
# Any OpenRouter model slug works (e.g. anthropic/claude-3.5-sonnet, meta-llama/...).
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_ENRICH_MODEL=openai/gpt-4o-mini
OPENROUTER_CHAT_MODEL=openai/gpt-4o

# --- Embeddings: local, no key ----------------------------------------------
# Runs on-device via transformers.js (OpenRouter has no embeddings endpoint).
# Changing the model changes the vector dimension — keep EMBEDDING_DIM
# (packages/core/src/db/constants.ts) and the vec_chunks migration in sync.
EMBEDDING_MODEL=Xenova/bge-small-en-v1.5

# --- Optional: raise source rate limits (fetch works without these) ---------
GITHUB_TOKEN=
NVD_API_KEY=

# --- Optional: alerts + storage ---------------------------------------------
# Slack incoming-webhook URL for impact >= 4 alerts; unset = in-app inbox only.
SLACK_WEBHOOK_URL=
# Override the single SQLite store location (defaults to data/leapfrog.sqlite).
LEAPFROG_DB_PATH=
