{
  "name": "@leapfrog/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "seed": "tsx src/index.ts seed",
    "fetch": "tsx src/index.ts fetch",
    "ingest": "tsx src/index.ts ingest",
    "enrich": "tsx src/index.ts enrich",
    "embed": "tsx src/index.ts embed",
    "start": "node dist/index.js",
    "build": "tsc --build",
    "typecheck": "tsc --build",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@leapfrog/core": "*"
  },
  "devDependencies": {
    "tsx": "^4.19.1"
  }
}
