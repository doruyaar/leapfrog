# Dependencies + build outputs are reinstalled/rebuilt inside the image.
**/node_modules
**/dist
**/.next
**/*.tsbuildinfo

# Local runtime state — never bake a laptop's database into an image.
data/leapfrog.sqlite
data/leapfrog.sqlite-*
data/*.sqlite
data/*.sqlite-*

# Private notes, local scratch clones, and editor state — never bake into an image.
.private
.tmp-*
.cursor

# VCS, env, and misc local artifacts.
.git
.gitignore
.env
.env.*
!.env.example
*.zip
npm-debug.log*
.DS_Store
Dockerfile
.dockerignore
